{
  "name": "@ecrituresnumeriques/stylo-graphql",
  "version": "3.13.2",
  "description": "",
  "main": "app.js",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "delete-user": "node bin/delete-user.mjs",
    "generate-service-token": "node -p \"try { process.loadEnvFile('../.env') } catch {}; require('jsonwebtoken').sign({ admin: true, roles: ['read'], readonly: true }, process.env.JWT_SECRET_SESSION_COOKIE, { expiresIn: '1 year' })\"",
    "test": "c8 --reporter=lcov node --test '**/*.test.js'",
    "migrations": "node --env-file-if-exists=../.env ../node_modules/.bin/db-migrate up",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "posttest": "npm run lint",
    "prestart": "npm run migrations",
    "start": "node app.js",
    "preprod": "npm run migrations",
    "prod": "NODE_ENV=production node --tls-max-v1.2 --heapsnapshot-signal=SIGUSR2 app.js"
  },
  "author": "",
  "license": "ISC",
